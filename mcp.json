{
	"mcpServers": {
		"rune-email": {
			"command": "rune",
			"args": ["run", "rune-email"],
			"env": {
				"PATH": "",
				"EMAIL_PRESET": "hostinger",
				"EMAIL_USER": "contact@yourdomain.com",
				"EMAIL_PASSWORD": "your_secure_password",
				"OUTPUT_DIR": "./test-dir/attachments"
			}
		},
		"rune-fetch": {
			"command": "rune",
			"args": ["run", "rune-fetch"]
		},
		"rune-filesystem": {
			"command": "rune",
			"args": ["run", "rune-filesystem"],
			"env": {
				"ALLOWED_DIR": "./test-dir"
			}
		},
		"rune-git": {
			"command": "rune",
			"args": ["run", "rune-git"],
			"env": {
				"ALLOWED_DIR": "./test-dir"
			}
		},
		"rune-image": {
			"command": "rune",
			"args": ["run", "rune-image"],
			"env": {
				"COOKIES_DIR": "./test-dir/cookies",
				"OUTPUT_DIR": "./test-dir/images",
				"ALLOWED_DIR": "./test-dir"
			}
		},
		"rune-time": {
			"command": "rune",
			"args": ["run", "rune-time"],
			"env": {
				"DEFAULT_TIMEZONE": "Asia/Kolkata"
			}
		},
		"rune-memory": {
			"command": "rune",
			"args": ["run", "rune-memory"],
			"env": {
				"ALLOWED_DIR": "./test-dir",
				"MEMORY_FILE": "graph_memory.json"
			}
		},
		"rune-sequentialthinking": {
			"command": "rune",
			"args": ["run", "rune-sequentialthinking"]
		},
		"rune-print": {
			"command": "rune",
			"args": ["run", "rune-print"],
			"env": {
				"PRINTER_IP": "192.168.1.2",
				"IPP_PATH": "/ipp/printer",
				"USE_HTTPS": "true",
				"ALLOWED_DIR": "./test-dir"
			}
		},
		"rune-video": {
			"command": "rune",
			"args": ["run", "rune-video"],
			"env": {
				"COOKIES_DIR": "./test-dir/cookies",
				"OUTPUT_DIR": "./test-dir/video",
				"ALLOWED_DIR": "./test-dir"
			}
		}
	}
}
