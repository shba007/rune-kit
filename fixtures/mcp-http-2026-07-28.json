  "cancellation": {
    "action": "Close the SSE response stream of a long request",
    "expected": "Only that operation is cancelled. No late response or replay; another request reusing its JSON-RPC id is independent."
  },
  "configuration": {
    "command": "rune-kit serve --headless --read-only -p allowed_dir=<existing absolute test folder>",
    "optionalBearerTokenEnvironment": "RUNE_KIT_HTTP_TOKEN",
